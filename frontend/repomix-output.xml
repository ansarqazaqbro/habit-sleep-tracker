              <div className="flex flex-wrap gap-1.5">
                {QUICK_PROMPTS.map((promptText) => (
                  <button
                    key={promptText}
                    type="button"
                    disabled={isLoading}
                    onClick={() => handleQuickPrompt(promptText)}
                    className="tag-chip text-left text-xs"
                  >
                    {promptText}
                  </button>
