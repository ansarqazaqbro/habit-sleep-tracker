                    <span className="truncate">Выполнение...</span>
                  </>
                ) : (
                  <>
                    <Send className="inline-block h-4 w-4 flex-shrink-0" />
                    <span className="truncate">Выполнить</span>
                  </>
                )}
              </button>
            </form>
          </div>
        </div>
      ) : null}
    </>
  )
}
