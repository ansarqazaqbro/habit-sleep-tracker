  white-space: nowrap;
  user-select: none;
  transition: background-color 120ms ease, color 120ms ease, opacity 120ms ease;
}

.liquid-btn:hover:not(:disabled),
.lumen-btn:hover:not(:disabled) {
  background-color: #1f1f23;
}

.lumen-btn--primary {
  background-color: #fafafa;
  color: #09090b;
  border: 1px solid #fafafa;
  font-weight: 600;
}

.lumen-btn--primary:hover:not(:disabled) {
  background-color: #e4e4e7;
}

.lumen-btn--ghost {
  background-color: transparent;
  color: #a1a1aa;
  border: 1px solid transparent;
}

.lumen-btn--ghost:hover:not(:disabled) {
  background-color: #141417;
  color: #fafafa;
}

.liquid-btn:disabled,
.lumen-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.glass-input,
.lumen-input {
  width: 100%;
  height: 2.5rem;
  background-color: #121214;
  border: 1px solid #27272a;
  border-radius: 8px;
  color: #fafafa;
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0 0.75rem;
  outline: none;
  transition: border-color 120ms ease;
}

.glass-input::placeholder,
.lumen-input::placeholder {
  color: #71717a;
  font-weight: 400;
}

.glass-input:focus,
.lumen-input:focus {
  border-color: #52525b;
  outline: none;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.3rem 0.65rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 500;
  cursor: pointer;
  color: #a1a1aa;
  background-color: #121214;
  border: 1px solid #222225;
  transition: color 120ms ease, background-color 120ms ease, opacity 120ms ease;
}

.tag-chip:hover:not(:disabled) {
  background-color: #18181b;
  color: #fafafa;
}

.tag-chip:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.tag-chip[aria-pressed="true"] {
  background-color: #fafafa;
  border-color: #fafafa;
  color: #09090b;
  font-weight: 600;
}

.tag-chip__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: currentColor;
}

.glass-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.82);
}

.heatmap-cell {
  width: 12px;
  height: 12px;
  border-radius: 3px;
  border: 1px solid #18181b;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
