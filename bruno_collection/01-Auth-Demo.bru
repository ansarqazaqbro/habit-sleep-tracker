meta {
  name: 1. Авторизация демо-пользователя (Bearer Token)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/demo
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody() && res.getBody().token) {
    bru.setEnvVar("token", res.getBody().token);
  }
}

tests {
  test("Статус 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Возвращён Bearer-токен Sanctum и профиль пользователя", function() {
    const body = res.getBody();
    expect(body).to.have.property("token");
    expect(body.user).to.have.property("email", "demo@habit.local");
  });
}

docs {
  # POST /api/auth/demo
  Авторизует демо-пользователя **Aurora (`demo@habit.local`)** и выдаёт персональный токен Laravel Sanctum.
  Скрипт `post-response` автоматически сохраняет полученный `token` в переменные окружения Bruno — все следующие запросы коллекции сразу используют его в заголовке `Authorization: Bearer {{token}}`.
}
