<file path="backend/tests/Feature/HabitToggleStreakTest.php">
<?php

namespace Tests\Feature;

use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Laravel\Sanctum\Sanctum;
use Tests\TestCase;

class HabitToggleStreakTest extends TestCase
{
    use RefreshDatabase;

    public function test_toggle_updates_streak_count_and_best_streak(): void
    {
        $user = User::factory()->create();
        $habit = $user->habits()->create(['title' => 'Чтение']);

        Sanctum::actingAs($user);

        $days = [
            now()->subDays(2)->toDateString(),
            now()->subDay()->toDateString(),
            now()->toDateString(),
        ];

        foreach ($days as $date) {
            $this->postJson("/api/habits/{$habit->id}/toggle", ['date' => $date])->assertOk();
        }

        $habit->refresh();
        $this->assertSame(3, $habit->streak_count);
        $this->assertSame(3, $habit->best_streak);
        $this->assertDatabaseCount('habit_logs', 3);

        // Un-toggle today: the streak is still alive through yesterday, best stays 3.
        $this->postJson("/api/habits/{$habit->id}/toggle")
            ->assertOk()
            ->assertJsonPath('streak_count', 2)
            ->assertJsonPath('best_streak', 3)
            ->assertJsonPath('completed_today', false);

        $this->assertDatabaseCount('habit_logs', 2);
    }

    public function test_gap_resets_current_streak(): void
    {
        $user = User::factory()->create();
        $habit = $user->habits()->create(['title' => 'Бег']);

        Sanctum::actingAs($user);

        // Completed 4 and 3 days ago, nothing since: current streak is 0, best is 2.
        foreach ([4, 3] as $offset) {
            $this->postJson("/api/habits/{$habit->id}/toggle", [
                'date' => now()->subDays($offset)->toDateString(),
            ])->assertOk();
        }

        $habit->refresh();
        $this->assertSame(0, $habit->streak_count);
        $this->assertSame(2, $habit->best_streak);
    }

    public function test_toggle_rejects_invalid_and_future_dates(): void
    {
        $user = User::factory()->create();
        $habit = $user->habits()->create(['title' => 'Йога']);

        Sanctum::actingAs($user);

        $this->postJson("/api/habits/{$habit->id}/toggle", ['date' => '20-10-2026'])
            ->assertUnprocessable()
            ->assertJsonValidationErrors('date');

        $this->postJson("/api/habits/{$habit->id}/toggle", ['date' => now()->addDays(3)->toDateString()])
            ->assertUnprocessable()
            ->assertJsonValidationErrors('date');
    }
}
</file>

<file path="backend/tests/Feature/SleepLogStatsTest.php">
<?php

namespace Tests\Feature;

use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Laravel\Sanctum\Sanctum;
use Tests\TestCase;

class SleepLogStatsTest extends TestCase
{
    use RefreshDatabase;

    public function test_sleep_log_is_stored_and_weekly_stats_are_calculated(): void
    {
        $user = User::factory()->create();
        Sanctum::actingAs($user);

        // 3 nights: 8h, 8h, 6h (all crossing midnight) with ratings 5, 4, 3.
        $nights = [
            [2, '23:00', '07:00', 5],
            [1, '23:00', '07:00', 4],
            [0, '23:00', '05:00', 3],
        ];

        foreach ($nights as [$offset, $bed, $wake, $rating]) {
            $this->postJson('/api/sleep', [
                'bed_time' => $bed,
                'wake_time' => $wake,
                'quality_rating' => $rating,
                'date' => now()->subDays($offset)->toDateString(),
            ])->assertCreated();
        }

        $this->assertDatabaseCount('sleep_logs', 3);

        $first = $this->getJson('/api/sleep')->assertOk()->json();
        $this->assertCount(3, $first);

        $this->getJson('/api/sleep/stats')
            ->assertOk()
            ->assertJsonStructure([
                'average_minutes', 'average_hours', 'average_quality', 'goal_percent',
                'nights_logged', 'regularity', 'recommendation',
                'chart' => [['date', 'label', 'hours', 'minutes', 'quality', 'goal_percent']],
            ])
            ->assertJsonCount(7, 'chart')
            ->assertJsonPath('nights_logged', 3)
            ->assertJsonPath('average_minutes', 440) // (480 + 480 + 360) / 3
            ->assertJsonPath('average_quality', 4)
            ->assertJsonPath('regularity', 100);
    }

    public function test_sleep_log_response_includes_duration_and_validates_rating(): void
    {
        Sanctum::actingAs(User::factory()->create());

        $this->postJson('/api/sleep', [
            'bed_time' => '23:30',
            'wake_time' => '07:15',
            'quality_rating' => 4,
        ])
            ->assertCreated()
            ->assertJsonPath('duration_minutes', 465)
            ->assertJsonPath('duration.hours', 7)
            ->assertJsonPath('duration.minutes', 45);

        $this->postJson('/api/sleep', [
            'bed_time' => '23:30',
            'wake_time' => '07:15',
            'quality_rating' => 6,
        ])->assertUnprocessable()->assertJsonValidationErrors('quality_rating');
    }

    public function test_user_cannot_read_another_users_sleep_log(): void
    {
        $owner = User::factory()->create();
        $log = $owner->sleepLogs()->create([
            'bed_time' => '23:00',
            'wake_time' => '07:00',
            'duration_minutes' => 480,
            'quality_rating' => 4,
            'date' => now()->toDateString(),
        ]);

        Sanctum::actingAs(User::factory()->create());

        $this->getJson("/api/sleep/{$log->id}")->assertForbidden();
    }
}
